default_platform(:ios)

# Assumes the web assets are already built and synced into the iOS project:
#   npm run build && npx cap sync ios
# (The GitHub Actions ios job / your release script does this before calling
# these lanes.)
platform :ios do
  desc "Fetch signing certs & profiles (read-only)"
  lane :certs do
    match(type: "appstore", readonly: true)
  end

  desc "Build a signed App Store IPA and upload to TestFlight"
  lane :beta do
    # CC-IOS-SURFACES (BD-1): the widget extension needs its own App ID
    # with the App Group, and the app's App ID needs the group too. All
    # portal work rides the ASC API key; every step is idempotent. If the
    # key lacks portal permission this fails LOUDLY here, before any
    # build minutes are spent.
    produce(app_identifier: "net.spellgame.app.SpellWidgets",
            app_name: "SpellGame Widgets", skip_itc: true)
    sh("bundle exec fastlane produce group -g group.net.spellgame.app -n 'SpellGame Shared' || true")
    sh("bundle exec fastlane produce associate_group -a net.spellgame.app group.net.spellgame.app")
    sh("bundle exec fastlane produce associate_group -a net.spellgame.app.SpellWidgets group.net.spellgame.app")
    match(type: "appstore", readonly: is_ci, force_for_new_devices: false)

    # Derive the build number from App Store Connect, never from the repo, so a
    # retry / local drift can't re-upload an existing build number (ITMS-90189
    # Redundant Binary Upload). Uses the API key auto-loaded from
    # APP_STORE_CONNECT_API_KEY_PATH (same auth gym/pilot already use). Marketing
    # version (MARKETING_VERSION / CFBundleShortVersionString) is untouched.
    next_build = latest_testflight_build_number(initial_build_number: 0) + 1
    UI.important("Build number -> #{next_build} (App Store Connect latest + 1)")
    # __dir__ is the fastlane/ folder, so this resolves regardless of the CWD
    # fastlane runs from.
    pbxproj = File.expand_path("../ios/App/App.xcodeproj/project.pbxproj", __dir__)
    contents = File.read(pbxproj)
    contents.gsub!(/CURRENT_PROJECT_VERSION = \d+;/, "CURRENT_PROJECT_VERSION = #{next_build};")
    File.write(pbxproj, contents)

    # match installs an "Apple Distribution" cert + this App Store profile and
    # exports its name via ENV. Force MANUAL signing so a headless/CI archive
    # never needs Xcode to interactively create a distribution profile.
    profile_name = ENV["sigh_net.spellgame.app_appstore_profile-name"]
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: "WCH6H5NAWH",
      bundle_identifier: "net.spellgame.app",
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["App"]
    )
    widget_profile = ENV["sigh_net.spellgame.app.SpellWidgets_appstore_profile-name"]
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: "WCH6H5NAWH",
      bundle_identifier: "net.spellgame.app.SpellWidgets",
      code_sign_identity: "Apple Distribution",
      profile_name: widget_profile,
      targets: ["SpellWidgets"]
    )

    gym(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      clean: true,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "net.spellgame.app" => profile_name,
          "net.spellgame.app.SpellWidgets" => widget_profile
        }
      }
    )
    # BD-1 acceptance #2: the widget extension binary links no networking
    # symbols — proven on the shipped artifact, not assumed.
    sh("cd .. && unzip -o -q build/App.ipa -d build/ipa-scan && scripts/widget-symbol-scan.sh 'build/ipa-scan/Payload/App.app/PlugIns/SpellWidgets.appex/SpellWidgets' && rm -rf build/ipa-scan")
    pilot(
      skip_waiting_for_build_processing: true,
      changelog: "See release notes."
    )
  end

  desc "Build, upload, and submit to external TestFlight (Beta App Review)"
  lane :beta_external do
    match(type: "appstore", readonly: is_ci)
    profile_name = ENV["sigh_net.spellgame.app_appstore_profile-name"]
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: "WCH6H5NAWH",
      bundle_identifier: "net.spellgame.app",
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["App"]
    )
    gym(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      clean: true,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { "net.spellgame.app" => profile_name }
      }
    )
    pilot(
      distribute_external: true,
      groups: ["Spell"],
      notify_external_testers: true,
      beta_app_feedback_email: "icyfxllm@gmail.com",
      beta_app_description: "Spell is a spelling game you play by ear. Tap the glowing orb to hear a word, then spell it on the on-screen keyboard and press Check. Replay or slow the word, use Definition/Sentence hints, and grow your chain. Fully playable offline after first load.",
      changelog: "Please try: tapping the orb to hear words, spelling on the on-screen keyboard, Replay/Slow, Definition/Sentence hints, head-to-head mode, and Kid Mode / Big Text in Settings.",
      beta_app_review_info: {
        contact_email: "icyfxllm@gmail.com",
        contact_first_name: "Eric",
        contact_last_name: "Hillman",
        contact_phone: "2604584592",
        demo_account_required: false,
        notes: "Native iOS spelling game, fully playable offline. No account or login required; no demo account needed. Tap the orb to hear a word, spell it on the on-screen keyboard, and press Check spelling."
      }
    )
  end

  desc "Submit the latest build to App Store review (metadata/screenshots already uploaded)"
  lane :submit_review do
    deliver(
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      build_number: ENV["SUBMIT_BUILD"] || "21",
      submit_for_review: true,
      run_precheck_before_submit: false,   # app has no IAP; precheck can't check IAP via API key
      automatic_release: true,
      force: true,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false,
        content_rights_contains_third_party_content: false
      }
    )
  end

  desc "Upload localized metadata + screenshots and submit the latest build for review"
  lane :submit_localized do
    deliver(
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      build_number: ENV["SUBMIT_BUILD"] || "21",
      submit_for_review: true,
      run_precheck_before_submit: false,
      automatic_release: true,
      force: true,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false,
        content_rights_contains_third_party_content: false
      }
    )
  end

  desc "Bump the iOS build number to the next TestFlight number"
  lane :bump do
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: latest_testflight_build_number(initial_build_number: 0) + 1
    )
  end

  # ---------------------------------------------------------------------------
  # ONE-COMMAND SHIP:  bundle exec fastlane ship
  #
  # Does the whole thing: builds the WASM + web bundle, syncs it into the iOS
  # project, picks the next build number from App Store Connect, signs, and
  # uploads to TestFlight.
  #
  # Why this exists alongside `beta`: `beta` signs via `match`, which needs the
  # spell-certs git repo + SSH/token + MATCH_PASSWORD. This lane instead mints the
  # distribution cert and App Store profile straight from the App Store Connect
  # API key (fastlane/api_key.json) — no certs repo, no SSH, no passphrase.
  #
  # It also works around two real hazards found on this Mac:
  #   1. The login keychain's password is out of sync with the account password, so
  #      codesign can't be granted access there. We use a DEDICATED keychain whose
  #      password we control, and set its partition list so signing never prompts.
  #   2. A copy of the same cert in the login keychain SHADOWS ours and makes
  #      codesign fail with errSecInternalComponent. So during signing we make our
  #      keychain the ONLY one in the search list, and always restore it after
  #      (ensure block) — even if the build fails.
  #
  # Override the keychain password with SPELL_KEYCHAIN_PASSWORD if you like.
  # ---------------------------------------------------------------------------
  desc "Build web+wasm, sign via API key in a dedicated keychain, upload to TestFlight"
  lane :ship do
    # fastlane/api_key.json is fastlane's own key-JSON (key_id/issuer_id/key), read
    # directly by each action via `api_key_path`. (The app_store_connect_api_key
    # ACTION takes different params — key_filepath/key_content — so we don't use it.)
    key_path = File.expand_path("api_key.json", __dir__)
    root = File.expand_path("..", __dir__)

    # 1. WASM + web bundle -> dist/ -> synced into the iOS project.
    sh("cd #{root.shellescape} && npm run sync:ios")

    # 2. Build number from App Store Connect (latest + 1) — never from the repo, so
    #    a retry can't re-upload an existing number (ITMS-90189). Edit the project
    #    file DIRECTLY (like the `beta` lane) rather than increment_build_number:
    #    the latter runs agvtool, which rewrites Info.plist's CFBundleVersion from
    #    $(CURRENT_PROJECT_VERSION) to a hardcoded literal and churns that file every
    #    build. This keeps Info.plist's indirection intact.
    next_build = latest_testflight_build_number(api_key_path: key_path, initial_build_number: 0) + 1
    UI.important("Build number -> #{next_build}")
    pbxproj = File.expand_path("../ios/App/App.xcodeproj/project.pbxproj", __dir__)
    File.write(pbxproj, File.read(pbxproj).gsub(/CURRENT_PROJECT_VERSION = \d+;/, "CURRENT_PROJECT_VERSION = #{next_build};"))

    # 3. Dedicated signing keychain (created on first run).
    kc_pw   = ENV["SPELL_KEYCHAIN_PASSWORD"] || "spellbuild-temp-pw"
    kc_path = File.expand_path("~/Library/Keychains/spellbuild.keychain-db")
    sh("security create-keychain -p #{kc_pw.shellescape} #{kc_path.shellescape}") unless File.exist?(kc_path)
    sh("security set-keychain-settings -lut 21600 #{kc_path.shellescape}")
    sh("security unlock-keychain -p #{kc_pw.shellescape} #{kc_path.shellescape}")

    # Distribution cert + App Store profile straight from the API key.
    get_certificates(
      development: false, api_key_path: key_path,
      keychain_path: kc_path, keychain_password: kc_pw
    )
    # force: the App IDs gained the App Group capability (BD-1) — stale
    # cached profiles predate it and fail codesign with entitlement errors.
    get_provisioning_profile(app_identifier: "net.spellgame.app", api_key_path: key_path, force: true)
    get_provisioning_profile(app_identifier: "net.spellgame.app.SpellWidgets", api_key_path: key_path, force: true)

    # Let codesign use the key without a GUI prompt (needs the keychain password,
    # which is why the dedicated keychain matters — we know THIS one).
    sh("security set-key-partition-list -S apple-tool:,apple:,codesign: " \
       "-s -k #{kc_pw.shellescape} #{kc_path.shellescape} > /dev/null 2>&1 || true")

    # 4. Archive + export with ONLY our keychain searchable (see hazard 2 above).
    update_code_signing_settings(
      use_automatic_signing: false, path: "ios/App/App.xcodeproj",
      team_id: "WCH6H5NAWH", bundle_identifier: "net.spellgame.app",
      code_sign_identity: "Apple Distribution",
      profile_name: "net.spellgame.app AppStore", targets: ["App"])
    update_code_signing_settings(
      use_automatic_signing: false, path: "ios/App/App.xcodeproj",
      team_id: "WCH6H5NAWH", bundle_identifier: "net.spellgame.app.SpellWidgets",
      code_sign_identity: "Apple Distribution",
      profile_name: "net.spellgame.app.SpellWidgets AppStore", targets: ["SpellWidgets"])
    begin
      sh("security list-keychains -d user -s #{kc_path.shellescape}")
      gym(
        project: "ios/App/App.xcodeproj",
        scheme: "App",
        configuration: "Release",
        export_method: "app-store",
        output_directory: "build",
        clean: true,
        # NOTE: no global PROVISIONING_PROFILE_SPECIFIER in xcargs — it would
        # poison the widget target. Specifiers are set per-target below.
        xcargs: "CODE_SIGN_STYLE=Manual DEVELOPMENT_TEAM=WCH6H5NAWH " \
                "CODE_SIGN_IDENTITY='Apple Distribution'",
        export_options: {
          signingStyle: "manual",
          teamID: "WCH6H5NAWH",
          provisioningProfiles: {
            "net.spellgame.app" => "net.spellgame.app AppStore",
            "net.spellgame.app.SpellWidgets" => "net.spellgame.app.SpellWidgets AppStore"
          }
        }
      )
    ensure
      # ALWAYS put the login keychain back, even if the build blew up.
      sh("security list-keychains -d user -s login.keychain-db #{kc_path.shellescape}")
    end

    # BD-1 acceptance #2: the shipped widget binary links no networking
    # symbols — proven on the artifact.
    sh("cd #{root.shellescape} && unzip -o -q build/App.ipa -d build/ipa-scan && scripts/widget-symbol-scan.sh 'build/ipa-scan/Payload/App.app/PlugIns/SpellWidgets.appex/SpellWidgets' && rm -rf build/ipa-scan")

    # 5. TestFlight.
    pilot(
      api_key_path: key_path,
      skip_waiting_for_build_processing: true,
      changelog: "See release notes."
    )
    UI.success("Shipped build #{next_build} to TestFlight.")
  end

  # Submit a build that is ALREADY uploaded for external Beta App Review.
  #
  # `ship` uploads internal-only, so external testers -- including anyone who
  # joins through the public TestFlight link -- see "no builds available" until
  # a build clears Beta App Review. This lane submits one without rebuilding
  # it, so the reviewed artifact is byte-identical to the tested one.
  #
  #   bundle exec fastlane submit_external_review build:204
  #
  # notify_external_testers is FALSE by design (Eric, 2026-08-26): the public
  # link is the invitation, so testers arrive on their own and nobody gets
  # mailed about a build they did not ask for.
  # Tell the external testers a build is waiting.
  #
  #   bundle exec fastlane notify build:240
  #
  # submit_external_review's notify:true only works at the moment it DISTRIBUTES
  # a build. Once a build is already with the group -- which it is as soon as it
  # has been submitted for review -- re-running the lane is a no-op, which is
  # why builds 237-240 sat at BETA_APPROVED with auto_notify false however many
  # times it was run (2026-09-22).
  #
  # This is the API behind App Store Connect's own "Notify Testers" button. It
  # moves the build from BETA_APPROVED to IN_BETA_TESTING within seconds, and it
  # MAILS EVERY EXTERNAL TESTER, so it is deliberately its own lane.
  desc "Notify external testers about an approved build"
  lane :notify do |options|
    build = options[:build] or UI.user_error!("pass build:NNN")
    key = Spaceship::ConnectAPI::Token.from_json_file(File.expand_path("api_key.json", __dir__))
    Spaceship::ConnectAPI.token = key
    app = Spaceship::ConnectAPI::App.find("net.spellgame.app")
    found = app.get_builds(includes: "buildBetaDetail", limit: 20).find { |b| b.version == build.to_s }
    UI.user_error!("build #{build} is not on App Store Connect") unless found
    before = found.build_beta_detail&.external_build_state
    UI.important("Build #{build} is #{before}")
    if before == "IN_BETA_TESTING"
      UI.success("Testers already have build #{build}. Nothing to send.")
      next
    end
    UI.user_error!("build #{build} is #{before}, not BETA_APPROVED -- it has not cleared review") unless before == "BETA_APPROVED"
    resp = Spaceship::ConnectAPI.post(
      path: "buildBetaNotifications",
      body: { data: { type: "buildBetaNotifications",
                      relationships: { build: { data: { type: "builds", id: found.id } } } } }
    )
    UI.important("POST buildBetaNotifications -> #{resp.status}")
    sleep(5)
    after = Spaceship::ConnectAPI::App.find("net.spellgame.app")
                                      .get_builds(includes: "buildBetaDetail", limit: 20)
                                      .find { |b| b.version == build.to_s }
                                      &.build_beta_detail
                                      &.external_build_state
    UI.success("Build #{build} is now #{after}")
    UI.error("Still #{after} -- the notification did not take") unless after == "IN_BETA_TESTING"
  end

  desc "Submit an already-uploaded build for external Beta App Review"
  lane :submit_external_review do |options|
    build = options[:build] or UI.user_error!("pass build:NNN")
    # What testers read in TestFlight. A build can carry its own note at
    # fastlane/changelog/<build>.md; without one the generic description below
    # goes out, so a forgotten file can never mail people last build's news.
    per_build = File.expand_path("changelog/#{build}.md", __dir__)
    # Explicit UTF-8: the note has em dashes and curly quotes, and a run
    # without LANG/LC_ALL set reads it as US-ASCII and dies on .strip.
    notes = File.exist?(per_build) ? File.read(per_build, encoding: "UTF-8").strip : nil
    UI.important(notes ? "Changelog: fastlane/changelog/#{build}.md" : "Changelog: the generic one (no per-build file)")
    pilot(
      api_key_path: File.expand_path("api_key.json", __dir__),
      app_identifier: "net.spellgame.app",
      # Without this, pilot stops to ASK for the platform and then crashes in
      # non-interactive mode.
      app_platform: "ios",
      distribute_only: true,
      app_version: options[:version] || "1.1",
      build_number: build.to_s,
      distribute_external: true,
      groups: ["Spell"],
      # Default TRUE since 2026-09-22 (Eric). It was false from 2026-08-26 on
      # the reasoning that the public link is the invitation and nobody should
      # be mailed about a build they did not ask for. The cost of that was
      # builds 230-240 sitting at BETA_APPROVED, approved and unannounced,
      # while testers stayed on 229 -- and the flag only bites at the moment a
      # build is DISTRIBUTED, so it could not be fixed after the fact by
      # re-running this lane. Now a build reaches testers as part of shipping
      # it. Pass notify:false for a build they should not be told about.
      notify_external_testers: options[:notify].to_s != "false",
      beta_app_feedback_email: "icyfxllm@gmail.com",
      beta_app_description: "Spell is a spelling game you play by ear. Tap the glowing orb to hear a word, then spell it on the on-screen keyboard and press Check. Replay or slow the word, use Definition/Sentence hints, and grow your chain. Fully playable offline after first load.",
      changelog: notes || "Tap the orb to hear a word and spell it on the on-screen keyboard. Try Replay and Slow, the Definition and Sentence hints, head-to-head mode, and Kid Mode / Big Text in Settings. Everything works offline after the first load.",
      beta_app_review_info: {
        contact_email: "icyfxllm@gmail.com",
        contact_first_name: "Eric",
        contact_last_name: "Hillman",
        contact_phone: "2604584592",
        demo_account_required: false,
        notes: "Native iOS spelling game, fully playable offline. No account or login required; no demo account needed. Tap the orb to hear a word, spell it on the on-screen keyboard, and press Check spelling."
      }
    )
    UI.success("Build #{build} submitted for external Beta App Review.")
  end
end
