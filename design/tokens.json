      "$value": "color-mix(in srgb, var(--controls-color) 25%, var(--bg))",
      "$css": "--panel-raised",
      "$description": "The play screen's primary controls (menu, setup bar, answer box, Delete): brighter than surface so they hold up on a black background (Eric, build 288 review)."
    },
    "edge-strong": {
