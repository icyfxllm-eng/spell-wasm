#!/bin/sh
# Static checks before a push. ~39s measured 2026-10-08 (41 checks, 26 of them
# with a selftest, plus the collision tables); the "roughly one second" this
# line used to claim stopped being true somewhere around the twentieth check.
# Catches the class of regression that reached main twice in three days.
#
# WHY THIS EXISTS. Two real breakages, both of which a second of checking would
# have stopped:
#
#   * A string on the play screen was localized into fifteen languages without
#     adding the joining-script letter-spacing reset, so Arabic rendered as
#     loose disconnected letters. tracking-check catches it. Pushed anyway,
#     and main failed its own gate until someone merged and noticed.
#   * The "Can't hear it" overlay shipped with left/right instead of
#     inset-inline, so it did not mirror for Arabic. css-logical-check catches
#     it -- but css-logical-check runs ONLY in GitHub Actions, never in
#     scripts/gate.sh, so a clean local gate said nothing and the workflow went
#     red on main.
#
# That second one is why this hook runs the CI-only checks too. A check that
# exists somewhere the author does not look is a check the author does not get.
#
# This is NOT the gate. No build, no cargo, no e2e -- those stay in gate.sh
# before a ship. This is only the part that is nearly free.
#
# Escape hatch: git push --no-verify. Use it when you mean to.
set -e
cd "$(git rev-parse --show-toplevel)"

command -v node >/dev/null 2>&1 || {
  echo "pre-push: node not found — refusing to pass checks that did not run" >&2
  exit 1
}

# Every static check that any gate or workflow runs, minus the two that need
# arguments or artifacts (e2e-summary-check wants a log, edu-no-purchase-check
# wants a built dist).
CHECKS="notices-ship-check ar-hi-ortho-check audio-clarity-check audio-router-check bank-variety-check def-pool-check letter-lexicon-check lexicon-load-check voice-spell-deps-check audio-session-owner-check mic-gate-check diag-dev-door-check audio-thread-check dom-id-check dom-id-live-check mode-exit-check i18n-translated-check snap-clean-one-impl-check snap-geometry-check snap-highlight-check snap-fixture-provenance-check snap-fixture-colour-check e2e-sleep-ratchet human-audio-check modes-check picture-artifact-parity pinyin-display-check pinyin-inventory-check ru-identity-check ru-stress-ingest-check scroll-check settings-truth-check spell-jr-name-check tier-list-check tier-partition-check tracking-check wordpic-export-parity zh-audio-path-check zh-bank-sandhi-check zh-grading-path-check css-logical-check entitlement-map-check"

# Checks that also expose a --selftest. A neutered check is worse than no check,
# because it reports OK, so the selftests ride along here too.
SELFTESTS="notices-ship-check audio-router-check def-pool-check letter-lexicon-check voice-spell-deps-check human-audio-check pinyin-display-check css-logical-check modes-check ru-stress-ingest-check settings-truth-check ru-identity-check spell-jr-name-check tier-list-check wordpic-export-parity dom-id-live-check mode-exit-check i18n-translated-check snap-clean-one-impl-check e2e-sleep-ratchet lexicon-load-check mic-gate-check diag-dev-door-check audio-thread-check snap-highlight-check snap-fixture-provenance-check snap-fixture-colour-check"

failed=""
for c in $CHECKS; do
  node "scripts/$c.mjs" >/dev/null 2>&1 || failed="$failed $c"
done
for c in $SELFTESTS; do
  node "scripts/$c.mjs" --selftest >/dev/null 2>&1 || failed="$failed $c(selftest)"
done

# The one non-node check that belongs here, and the reason it does.
#
# tools/build_collisions.py --check regenerates the en/es/ru collision tables
# and fails if the committed ones differ. It lived only in scripts/gate.sh, so
# ebd6a673 pushed an English table of 80 sets where it had been 239 to 264 for
# its whole history -- generated in a worktree that lacked the then-gitignored
# cmudict. A collision set is accept-all, so 184 missing sets meant learners
# marked WRONG for real words the audio cannot tell apart, live on main for a
# day. cmudict is committed now (2026-10-08) precisely so this can run here.
#
# It costs 0.9s and needs no build, so it keeps this hook's one-second promise.
if command -v python3 >/dev/null 2>&1; then
  python3 tools/build_collisions.py --check >/dev/null 2>&1 || failed="$failed collision-check"
else
  echo "pre-push: python3 not found — the collision tables went UNCHECKED" >&2
fi

if [ -n "$failed" ]; then
  echo "" >&2
  echo "pre-push BLOCKED —$failed" >&2
  echo "" >&2
  for c in $failed; do
    case "$c" in *"(selftest)"*) continue;; esac
    echo "--- $c ---" >&2
    if [ "$c" = "collision-check" ]; then
      python3 tools/build_collisions.py --check 2>&1 | head -12 >&2
    else
      node "scripts/$c.mjs" 2>&1 | head -12 >&2
    fi
    echo "" >&2
  done
  echo "Fix, or push with --no-verify if you mean to." >&2
  exit 1
fi
echo "pre-push: $(echo $CHECKS | wc -w | tr -d ' ') static checks + the collision tables OK"
